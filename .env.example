# Copy to .env and fill in. .env is gitignored.

# FuelArk telemetry API
FUELARK_API_KEY=
FUELARK_API_URL=https://api1.fuelark.com/api/FuelConsumption/DeviceFuelConsumption

# Optional: bearer-token login (fuel_api.login_and_get_token)
FUELARK_BASE_URL=https://web1.fuelark.com
FUELARK_USERNAME=
FUELARK_PASSWORD=

# Detector
FUEL_DETECTOR_TZ=Asia/Kolkata
